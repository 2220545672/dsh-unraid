# Caddy — lan mode. Selected by the entrypoint when PUBLIC_URL is empty.
#
# Same contract as Caddyfile.edge, with one difference that matters: the Host
# presented to DSH is the loopback listener, and the browser's Origin is
# stripped. DSH's fence then accepts the request because the Host is loopback,
# while the two defences that protect a LAN deployment stay in force:
#   * DNS rebinding cannot forge Host, so a rebound browser read is refused;
#   * the fence still rejects any request marked `Sec-Fetch-Site: cross-site`,
#     which is how a malicious page's fetch() announces itself.
#
# Use this mode for a trusted LAN (or a VPN) only. In front of the internet,
# set PUBLIC_URL and terminate TLS at an authenticating proxy.
{
	admin off
	auto_https off
	grace_period 10s
	# TRUSTED_PROXIES — replaced by the entrypoint when TRUSTED_PROXY_CIDRS is set
}

# The header list DSH is given, shared by every proxy block so it exists once. Host is
# loopback (what DSH's fence accepts in lan mode), and every identity header a proxy may
# have added is stripped so nothing downstream can believe it is already authenticated.
(dsh_upstream_headers) {
	header_up Host {$DSH_UPSTREAM_HOST}
	header_up -Origin
	header_up -Authorization
	header_up -Remote-User
	header_up -X-Auth-User
	header_up -X-Authenticated-User
	header_up -X-Email
	header_up -X-Forwarded-User
	header_up -X-Roles
	header_up -X-Remote-User
	header_up -X-User
	header_up -X-Webauth-User
}

:{$PORT} {
	# ACCESS_CONTROL — replaced by the entrypoint from ALLOWED_CLIENTS
	header {
		-Server
		Content-Security-Policy "base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@forwarded_https header X-Forwarded-Proto https
	header @forwarded_https Strict-Transport-Security "max-age=31536000"

	route /healthz {
		respond "ok" 200
	}

	# PASSWORD_GATE — replaced by the entrypoint when AUTH_MODE=builtin

	route /dsh-deployment.js {
		header {
			Content-Type "application/javascript; charset=utf-8"
			Cache-Control "no-store"
		}
		respond "globalThis.__DSH_AUTHENTICATED_SETTINGS__ = true;" 200
	}

	# One-click recovery for a browser whose DSH session cookie is no longer valid.
	# That cookie is signed with a secret this process owns and bound to the authority
	# DSH sees, so it goes stale when the image is replaced, the container is recreated,
	# or another DSH instance on the same host wrote a cookie of the same name (cookies
	# ignore ports). The bootstrap below cannot help then: it deliberately stays out of
	# the way while *any* dsh-auth-* cookie is present, and DSH answers a stale one with
	# 401 "authentication required; reopen the URL printed by dsh web". /renew replays the
	# launch token so DSH mints a fresh cookie, and the next request to / is served
	# normally — nothing to clear by hand, and no redirect loop, because the rewritten
	# URL carries the token while the final request carries a valid cookie.
	route /renew {
		redir * /?token={$DSH_LAUNCH_TOKEN} 303
	}

	# /remote-signin/inpage.js is served by DSH itself — it belongs to the remote-sign-in
	# plugin (github.com/2220545672/dsh-remote-signin), which registers it on the web
	# server. It needs no route here: the catch-all below proxies it like any other path,
	# and the password gate above still applies.

	@dsh_bootstrap {
		path /
		not header Cookie *dsh-auth-*
	}
	@native_settings_api path /api/settings.openDocument /api/settings.openSettingsDocument

	route @native_settings_api {
		respond "Forbidden" 403
	}

	# A stale session cookie looks exactly like a valid one from out here, so let DSH
	# decide: when it answers 401 for the document, send the browser through /renew
	# (which replays the launch token) rather than showing the dead end it prints. The
	# marker cookie keeps that to one attempt, so a session that still cannot be
	# established shows DSH's own 401 instead of bouncing forever. The bootstrap below
	# cannot cover this case: it deliberately fires only when no dsh-auth-* cookie is
	# present at all, which is exactly the condition this route requires — the two are
	# mutually exclusive, so neither can shadow the other.
	@stale_session {
		method GET
		path /
		not query token=*
		header Cookie *dsh-auth-*
		not header Cookie *dsh_renew=1*
	}

	route @stale_session {
		reverse_proxy 127.0.0.1:{$DSH_INTERNAL_PORT} {
			import dsh_upstream_headers
			@unauthorized status 401
			handle_response @unauthorized {
				header Set-Cookie "dsh_renew=1; Path=/; HttpOnly; SameSite=Lax; Max-Age=30"
				redir * /renew 302
			}
		}
	}

	route {
		rewrite @dsh_bootstrap /?token={$DSH_LAUNCH_TOKEN}
		reverse_proxy 127.0.0.1:{$DSH_INTERNAL_PORT} {
			import dsh_upstream_headers
		}
	}
}
